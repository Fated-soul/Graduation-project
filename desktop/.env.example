# PostgreSQL connection used by the local backend.
IOT_DB_NAME=IOT
IOT_DB_USER=postgres
IOT_DB_PASSWORD=123
IOT_DB_HOST=127.0.0.1
IOT_DB_PORT=5432

# Alibaba Cloud Bailian. The application can browse data without a key,
# but complete Agent generation, embeddings and reranking require one.
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=deepseek-v4.1-flash
DASHSCOPE_ENABLE_THINKING=true
DASHSCOPE_REASONING_EFFORT=low
DASHSCOPE_MAX_TOKENS=2400
DASHSCOPE_TIMEOUT_SECONDS=180

MINGCHA_BACKEND_API_URL=http://127.0.0.1:8000
MINGCHA_BACKEND_API_TIMEOUT_SECONDS=15
RAG_ENABLED=true
RAG_USE_EMBEDDINGS=true
RAG_EMBEDDING_MODEL=text-embedding-v4
RAG_EMBEDDING_DIMENSIONS=512
RAG_TOP_K=4
RAG_MIN_SCORE=0.08
RAG_CHUNK_SIZE=900
RAG_USE_RERANKER=true
RAG_RERANK_MODEL=qwen3-rerank
RAG_RERANK_CANDIDATES=16
RAG_RERANK_TIMEOUT_SECONDS=30
AGENT_ALLOW_RULE_FALLBACK=true
