**/*.py[cod]
**/.pytest_cache/
**/.venv/
**/venv/
agent/cache/
backend/cache/
desktop/build/
desktop/dist/
desktop/.venv/
desktop/.pip-cache/
desktop/assets/*.ico
*.log
*.tmp
.DS_Store

